{
  "name": "imx",
  "version": "0.0.3",
  "description": "Immutable Extensions for JavaScript and TypeScript",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc",
    "test": "npm run build && mocha -u bdd --timeout 10000 dist/test/*.js",
    "lint": "prettier --check \"**/*.ts\"",
    "format": "prettier --write \"**/*.ts\""
  },
  "keywords": [
    "immutable",
    "record",
    "persistent"
  ],
  "author": "Andrea Guarino",
  "license": "MIT",
  "homepage": "https://github.com/andre989/imx",
  "repository": {
    "type": "git",
    "url": "https://github.com/andre989/imx.git"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.8",
    "@types/node": "^22.10.1",
    "@types/sinon": "^17.0.0",
    "mocha": "^10.8.2",
    "prettier": "^3.3.3",
    "should": "^13.2.3",
    "sinon": "^19.0.0",
    "typescript": "^5.7.2"
  }
}
